<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('./partials/head.ejs') %>
    <title>HyperScript | Home</title>
    <style>
        body {
            background: linear-gradient(180deg, #f8fafc 0%, #eef4ff 100%);
            color: #0f172a;
        }

        .hero {
            padding: 5rem 0 3rem;
        }

        .hero-badge {
            display: inline-block;
            padding: 0.55rem 1rem;
            border-radius: 999px;
            background: rgba(37, 99, 235, 0.09);
            color: #2563eb;
            font-size: 0.82rem;
            font-weight: 700;
            letter-spacing: 0.05em;
            text-transform: uppercase;
        }

        .hero h1 {
            font-size: clamp(2.6rem, 5vw, 4.5rem);
            font-weight: 800;
            line-height: 1.1;
            margin: 1.2rem 0 1rem;
        }

        .hero p {
            font-size: 1.08rem;
            color: #475569;
            max-width: 640px;
        }

        .hero-actions {
            display: flex;
            flex-wrap: wrap;
            gap: 1rem;
            margin-top: 2rem;
        }

        .hero-card {
            background: #ffffff;
            border: 1px solid rgba(148, 163, 184, 0.15);
            border-radius: 1.5rem;
            box-shadow: 0 25px 60px rgba(15, 23, 42, 0.12);
            padding: 1rem;
        }

        .feature-box {
            background: linear-gradient(135deg, #eff6ff 0%, #eef2ff 100%);
            border-radius: 1.25rem;
            padding: 1.3rem;
            margin-bottom: 1rem;
        }

        .feature-box small {
            display: inline-block;
            margin-bottom: 0.6rem;
            color: #4f46e5;
            font-weight: 700;
        }

        .feature-box h3 {
            margin: 0;
            font-size: 1.3rem;
            font-weight: 700;
        }

        .section-title {
            font-size: 2rem;
            font-weight: 800;
            margin-bottom: 2rem;
        }

        .blog-card {
            border: none;
            border-radius: 1.35rem;
            overflow: hidden;
            background: #fff;
            box-shadow: 0 18px 40px rgba(15, 23, 42, 0.08);
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }

        .blog-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 24px 48px rgba(15, 23, 42, 0.12);
        }

        .blog-image {
            height: 220px;
            overflow: hidden;
            background: #e2e8f0;
        }

        .blog-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .empty-state {
            background: #fff;
            border: 1px dashed rgba(96, 165, 250, 0.5);
            border-radius: 1.25rem;
            padding: 3rem 2rem;
            text-align: center;
            color: #475569;
        }

        .text-truncate-3 {
            display: -webkit-box;
            -webkit-line-clamp: 3;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }
    </style>
</head>
<body>
    <%- include('./partials/navbar.ejs') %>

    <section class="hero">
        <div class="container">
            <div class="row align-items-center g-4">
                <div class="col-lg-6">
                    <span class="hero-badge">Fresh ideas daily</span>
                    <h1>Write, publish, and share your story with the world.</h1>
                    <p>
                        HyperScript is a modern space for thoughtful articles, personal projects, and creative ideas.
                        Explore stories, build your audience, and keep the conversation going.
                    </p>
                    <div class="hero-actions">
                        <% if (user) { %>
                            <a href="/blog/add-new" class="btn btn-primary btn-lg rounded-pill px-4">Write a blog</a>
                        <% } else { %>
                            <a href="/user/signup" class="btn btn-primary btn-lg rounded-pill px-4">Get started</a>
                            <a href="/user/signin" class="btn btn-outline-primary btn-lg rounded-pill px-4">Sign in</a>
                        <% } %>
                    </div>
                </div>

                <div class="col-lg-6">
                    <div class="hero-card">
                        <div class="feature-box">
                            <small>Trending topic</small>
                            <h3>Building meaningful digital experiences</h3>
                        </div>
                        <div class="feature-box">
                            <small>Community</small>
                            <h3>Better stories, stronger discussions</h3>
                        </div>
                        <div class="feature-box">
                            <small>Creator tools</small>
                            <h3>Publish beautiful posts in minutes</h3>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <main class="container py-5">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="section-title mb-0">Latest posts</h2>
            <span class="text-muted"><%= blogs.length %> article(s)</span>
        </div>

        <% if (blogs.length === 0) { %>
            <div class="empty-state">
                <h4 class="mb-2">No blogs published yet</h4>
                <p class="mb-0">Be the first one to share a story on HyperScript.</p>
            </div>
        <% } else { %>
            <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
                <% blogs.forEach(blog => { %>
                    <div class="col">
                        <div class="card blog-card h-100">
                            <div class="blog-image">
                                <img src="<%= blog.coverImageUrl %>" alt="<%= blog.title %>">
                            </div>
                            <div class="card-body d-flex flex-column p-4">
                                <h5 class="card-title fw-bold mb-3"><%= blog.title %></h5>
                                <p class="card-text text-secondary text-truncate-3 mb-4">
                                    <%= blog.body ? blog.body.slice(0, 140) : 'Read this article to explore the full story.' %>
                                </p>
                                <div class="mt-auto">
                                    <a href="/blog/<%= blog._id %>" class="btn btn-outline-primary rounded-pill px-3">Read article</a>
                                </div>
                            </div>
                        </div>
                    </div>
                <% }) %>
            </div>
        <% } %>
    </main>

    <%- include('./partials/script.ejs') %>
    <%- include('./partials/footer.ejs') %>
</body>
</html>