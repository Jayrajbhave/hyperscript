<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('./partials/head.ejs') %>
    <title>Write a story | HyperScript</title>
</head>
<body>
    <%- include('./partials/navbar.ejs') %>
    <main class="container py-5">
        <div class="mx-auto" style="max-width: 860px;">
            <div class="mb-4">
                <span class="text-uppercase fw-bold small" style="color: var(--brand); letter-spacing: .12em;">Your writing space</span>
                <h1 class="display-6 fw-bold mt-2 mb-2">Create a new story</h1>
                <p class="text-secondary mb-0">Turn an idea into something worth sharing.</p>
            </div>
            <form action="/blog" method="post" enctype="multipart/form-data" class="bg-white p-3 p-md-4 rounded-4 shadow-sm border">
                <div class="mb-4">
                    <label for="coverImage" class="form-label fw-semibold">Cover image <span class="text-secondary fw-normal">(optional)</span></label>
                    <input type="file" name="coverImage" id="coverImage" class="form-control" accept="image/*">
                </div>
                <%- include('./partials/ai-assistant.ejs') %>
                <div class="mb-4">
                    <label for="title" class="form-label fw-semibold">Story title</label>
                    <input type="text" name="title" id="title" placeholder="Give your story a memorable title" class="form-control form-control-lg" required maxlength="200">
                </div>
                <div class="mb-4">
                    <label for="body" class="form-label fw-semibold">Your story</label>
                    <textarea name="body" id="body" rows="14" class="form-control" placeholder="Start writing here..." required></textarea>
                </div>
                <div class="d-flex flex-wrap justify-content-end gap-2">
                    <a href="/" class="btn btn-light rounded-pill px-4">Cancel</a>
                    <button type="submit" class="btn btn-primary rounded-pill px-4">Publish story</button>
                </div>
            </form>
        </div>
    </main>
    <%- include('./partials/script.ejs') %>
</body>
</html>
