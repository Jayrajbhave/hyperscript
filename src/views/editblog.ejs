<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('./partials/head.ejs') %>
    <title>Edit story | HyperScript</title>
</head>
<body>
    <%- include('./partials/navbar.ejs') %>
    <main class="container py-5">
        <div class="mx-auto" style="max-width: 860px;">
            <div class="mb-4">
                <span class="text-uppercase fw-bold small" style="color: var(--brand); letter-spacing: .12em;">Keep refining</span>
                <h1 class="display-6 fw-bold mt-2 mb-2">Edit your story</h1>
                <p class="text-secondary mb-0">Make a change, polish a sentence, or ask your AI writing assistant.</p>
            </div>
            <form action="/blog/<%= blog._id %>/edit" method="post" enctype="multipart/form-data" class="bg-white p-3 p-md-4 rounded-4 shadow-sm border">
                <div class="mb-4">
                    <label for="coverImage" class="form-label fw-semibold">Replace cover image</label>
                    <input type="file" name="coverImage" id="coverImage" class="form-control" accept="image/*">
                    <% if (blog.coverImageUrl) { %>
                        <img src="<%= blog.coverImageUrl %>" class="img-thumbnail mt-3 rounded-3" width="180" alt="Current cover image">
                    <% } %>
                </div>
                <%- include('./partials/ai-assistant.ejs') %>
                <div class="mb-4">
                    <label for="title" class="form-label fw-semibold">Story title</label>
                    <input type="text" name="title" id="title" value="<%= blog.title %>" class="form-control form-control-lg" required maxlength="200">
                </div>
                <div class="mb-4">
                    <label for="body" class="form-label fw-semibold">Your story</label>
                    <textarea name="body" id="body" class="form-control" rows="14" required><%= blog.body %></textarea>
                </div>
                <div class="d-flex flex-wrap justify-content-end gap-2">
                    <a href="/blog/<%= blog._id %>" class="btn btn-light rounded-pill px-4">Cancel</a>
                    <button type="submit" class="btn btn-primary rounded-pill px-4">Save changes</button>
                </div>
            </form>
        </div>
    </main>
    <%- include('./partials/script.ejs') %>
</body>
</html>
